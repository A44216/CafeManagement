<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activities.home.topping.UpdateToppingActivity">

    <!-- Nút quay lại -->
    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_back"
        android:contentDescription="@string/desc_back_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="12dp"/>

    <!-- TITLE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/update_topping_title"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        android:layout_marginTop="12dp"
        android:layout_marginStart="22dp"/>

    <!-- TÊN TOPPING -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutToppingNameAdmin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/topping_name"
        app:layout_constraintTop_toBottomOf="@id/ivBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etToppingNameAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textSize="18sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- GIÁ TOPPING -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutToppingPriceAdmin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/topping_price"
        app:layout_constraintTop_toBottomOf="@id/layoutToppingNameAdmin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etToppingPriceAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textSize="18sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUpdateToppingAdmin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/update_topping"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:padding="10dp"
        app:backgroundTint="@color/black"
        app:cornerRadius="4dp"
        app:layout_constraintTop_toBottomOf="@id/layoutToppingPriceAdmin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
